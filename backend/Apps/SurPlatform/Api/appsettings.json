{
  "Application": {
    "TimeZone": "UTC"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Clients": [
    {
      "Host": "localhost",
      "ConnectionString": "Host=localhost;Port=5432;Database=sur_local;Username=sur_local;Password=***"
    }
  ],
  "Operations": {
    "PauseOutbound": false
  },
  "Documents": {
    "Minio": {
      "Endpoint": "localhost:9000",
      "Bucket": "sur-documents",
      "UseTls": true,
      "AccessKey": "",
      "SecretKey": ""
    }
  },
  "Jwt": {
    "AccessTokenSettings": {
      "Audience": "IdentityClient",
      "LifeTimeInSeconds": 300
    },
    "SessionLifetimeDays": 30,
    "RefreshTokenSettings": {
      "Length": 64,
      "LifeTimeInMinutes": 10080
    }
  },
  "AuditLogCleanup": {
    "RetentionDays": 14,
    "CheckIntervalHours": 4
  },
  "JwtKeys": {
    "DirectoryPath": "identity-keys"
  }
}
