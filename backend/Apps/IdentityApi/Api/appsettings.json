{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDatabase": "Host=localhost;Port=5432;Database=risk_identity;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "http://localhost:5248/identity",
    "Audience": "IdentityClient",
    "AccessTokenLifetimeSeconds": 3600,
    "RefreshTokenLengthBytes": 64,
    "RefreshTokenLifetimeMinutes": 10080
  },
  "JwtKeys": {
    "DirectoryPath": "identity-keys",
    "PrivateKeyFileName": "jwt-private.pem",
    "PublicKeyFileName": "jwt-public.pem",
    "RsaKeySize": 4096
  }
}